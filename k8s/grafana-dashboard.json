          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(xdp_guard_packets_dropped_total[1m])",
          "legendFormat": "Dropped PPS (XDP Driver)",
          "refId": "B"
